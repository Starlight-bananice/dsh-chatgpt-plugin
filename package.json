{
  "name": "@bananiceee/dsh-chatgpt-provider",
  "version": "0.1.1",
  "description": "Sign in with ChatGPT inside DeepSeek Harness and run ChatGPT plan models directly: OpenAI Sign-in-with-ChatGPT (SIWC) OAuth token sharing feeding an official Responses API adapter. 在 DeepSeek Harness 里登录 ChatGPT 账号并直接使用 ChatGPT 模型。",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "chatgpt",
    "openai",
    "siwc",
    "oauth",
    "llm-adapter",
    "responses-api"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "scripts/build.sh",
    "scripts/tsconfig.client.template.json",
    "docs",
    "README.md",
    "tests"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-models",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "jsdom": "^30.1.1",
    "react": "~18.3.1",
    "react-dom": "~18.3.1",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "yaml": "^2.9.1"
  },
  "scripts": {
    "build": "bash scripts/build.sh",
    "build:client": "tsdown",
    "typecheck:client": "bash scripts/build.sh --client-only",
    "test": "node tests/verify.mjs && node tests/mount.mjs && node tests/adapter.mjs && node tests/signin.mjs && node tests/client.mjs && node tests/registry.mjs",
    "test:contract": "node tests/verify.mjs",
    "test:mount": "node tests/mount.mjs",
    "test:signin": "node tests/signin.mjs",
    "test:adapter": "node tests/adapter.mjs",
    "test:client": "node tests/client.mjs",
    "test:registry": "node tests/registry.mjs"
  }
}
